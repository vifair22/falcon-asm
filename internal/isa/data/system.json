  {
    "name": "pushf",
    "summary": "Push FLAGS Register onto the Stack",
    "category": "PUSH",
    "cpl": 3,
    "flagsRead": "CF PF AF ZF SF TF IF DF OF IOPL NT AC VIF VIP ID",
    "forms": [
      {
        "isaSet": "I86"
      }
    ],
    "aliases": [
      "pushfd"
    ],
    "notes": "pushfw 16-bit, pushfl 32-bit (not in 64-bit mode), pushfq 64-bit; VM and RF are stored as 0"
  },
  {
    "name": "popf",
    "summary": "Pop Stack into FLAGS Register",
    "category": "POP",
    "cpl": 3,
    "flagsRead": "IOPL VM",
    "flagsWritten": "CF PF AF ZF SF TF IF DF OF IOPL NT RF AC ID",
    "forms": [
      {
        "isaSet": "I86"
      }
    ],
    "aliases": [
      "popfd"
    ],
    "notes": "IF changes only if CPL <= IOPL and IOPL only at CPL 0; VM, VIP and VIF are unchanged; RF is cleared. popfw 16-bit, popfl 32-bit (not in 64-bit mode), popfq 64-bit"
  },
  {
    "name": "pusha",
    "summary": "Push All 16/32-bit General-Purpose Registers",
    "category": "PUSH",
    "cpl": 3,
    "modes": "16,32",
    "forms": [
      {
        "isaSet": "I186"
      }
    ],
    "aliases": [
      "pushad"
    ],
    "notes": "pushaw pushes AX..DI, pushal EAX..EDI (the stored SP/ESP is its value before the first push)"
  },
  {
    "name": "popa",
    "summary": "Pop All 16/32-bit General-Purpose Registers",
    "category": "POP",
    "cpl": 3,
    "modes": "16,32",
    "forms": [
      {
        "isaSet": "I186"
      }
    ],
    "aliases": [
      "popad"
    ],
    "notes": "The saved SP/ESP slot is discarded, not loaded"
  },
