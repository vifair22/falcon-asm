{
  "name": "falcon-asm",
  "displayName": "falcon-asm (GAS x86)",
  "description": "GAS (AT&T) x86 assembly support backed by the falcon-asm language server: hover and semantic highlighting.",
  "version": "0.1.0",
  "publisher": "vifair22",
  "license": "GPL-3.0-or-later",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://git.airies.net/vifair22/falcon-asm"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "assembly",
    "gas",
    "x86",
    "att",
    "lsp"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:falcon-asm"
  ],
  "contributes": {
    "languages": [
      {
        "id": "falcon-asm",
        "aliases": [
          "GAS x86",
          "falcon-asm"
        ],
        "extensions": [
          ".S",
          ".s"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "falcon-asm",
        "scopeName": "source.falcon-asm",
        "path": "./syntaxes/falcon-asm.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "falcon-asm",
        "scopes": {
          "keyword": [
            "keyword.other.mnemonic.falcon-asm",
            "keyword"
          ],
          "keyword.defaultLibrary": [
            "keyword.control.privileged.falcon-asm",
            "keyword.control"
          ],
          "modifier": [
            "storage.modifier.prefix.falcon-asm",
            "storage.modifier"
          ],
          "variable": [
            "variable.other.register.falcon-asm",
            "variable.language",
            "variable"
          ],
          "number": [
            "constant.numeric.falcon-asm",
            "constant.numeric"
          ],
          "label": [
            "entity.name.label.falcon-asm",
            "entity.name.function"
          ],
          "label.declaration": [
            "entity.name.function.label.falcon-asm",
            "entity.name.function"
          ],
          "macro": [
            "entity.name.function.preprocessor.falcon-asm",
            "entity.name.function.preprocessor",
            "keyword.control.directive"
          ],
          "comment": [
            "comment.falcon-asm",
            "comment"
          ],
          "string": [
            "string.quoted.falcon-asm",
            "string"
          ],
          "operator": [
            "storage.type.suffix.falcon-asm",
            "storage.type"
          ],
          "type": [
            "keyword.other.directive.falcon-asm",
            "keyword.other",
            "keyword"
          ],
          "parameter": [
            "constant.other.immediate.falcon-asm",
            "constant.numeric"
          ],
          "*.deprecated": [
            "invalid.deprecated"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[falcon-asm]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": {
      "title": "falcon-asm",
      "properties": {
        "falcon-asm.serverPath": {
          "type": "string",
          "default": "falcon-asm",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `falcon-asm` language server binary. A bare name is looked up on `PATH`; `~/` is expanded to the home directory. Changing it restarts the server."
        },
        "falcon-asm.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Trace the JSON-RPC traffic between VS Code and the falcon-asm server in the output channel."
        }
      }
    },
    "commands": [
      {
        "command": "falcon-asm.restartServer",
        "title": "Restart Language Server",
        "category": "falcon-asm"
      }
    ]
  },
  "scripts": {
    "build": "npm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "prepackage": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\" && npm run build -- --production",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
