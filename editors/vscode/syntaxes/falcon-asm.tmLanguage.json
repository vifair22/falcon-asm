{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "falcon-asm (GAS x86)",
  "scopeName": "source.falcon-asm",
  "comment": "Base layer only: painted immediately, then overridden by the server's semantic tokens. Kept small and line-local on purpose; anything that needs ISA knowledge (prefixes, suffixes, privileged instructions, macro uses) is the server's job.",
  "patterns": [
    { "include": "#block-comment" },
    { "include": "#preprocessor" },
    { "include": "#line-comment" },
    { "include": "#string" },
    { "include": "#char" },
    { "include": "#label-definition" },
    { "include": "#statement-head" },
    { "include": "#operand" }
  ],
  "repository": {
    "block-comment": {
      "name": "comment.block.falcon-asm",
      "begin": "/\\*",
      "end": "\\*/",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.falcon-asm" } },
      "endCaptures": { "0": { "name": "punctuation.definition.comment.end.falcon-asm" } }
    },
    "line-comment": {
      "comment": "A '#' that did not start a cpp directive is a GAS comment. The preprocessor rules come first in every list that includes this, so '#include' never lands here.",
      "patterns": [
        {
          "name": "comment.line.double-slash.falcon-asm",
          "match": "(//).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.falcon-asm" } }
        },
        {
          "name": "comment.line.number-sign.falcon-asm",
          "match": "(#).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.falcon-asm" } }
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "comment": "#include <path> / #include \"path\": single line, path painted as a string.",
          "name": "meta.preprocessor.include.falcon-asm",
          "match": "^\\s*((#)\\s*(?:include_next|include))\\b\\s*(<[^>]*>|\"(?:[^\"\\\\]|\\\\.)*\")?",
          "captures": {
            "1": { "name": "keyword.control.directive.include.falcon-asm" },
            "2": { "name": "punctuation.definition.directive.falcon-asm" },
            "3": { "name": "string.quoted.other.include.falcon-asm" }
          }
        },
        {
          "comment": "#define / #undef: the macro name is a declaration. Runs to an end of line not preceded by a backslash continuation.",
          "name": "meta.preprocessor.macro.falcon-asm",
          "begin": "^\\s*((#)\\s*(?:define|undef))\\b\\s*([A-Za-z_]\\w*)?",
          "end": "(?<!\\\\)$",
          "beginCaptures": {
            "1": { "name": "keyword.control.directive.define.falcon-asm" },
            "2": { "name": "punctuation.definition.directive.falcon-asm" },
            "3": { "name": "entity.name.function.preprocessor.falcon-asm" }
          },
          "patterns": [ { "include": "#preprocessor-body" } ]
        },
        {
          "comment": "Conditional and diagnostic directives. Longest alternatives first so 'ifdef' is never read as 'if'.",
          "name": "meta.preprocessor.falcon-asm",
          "begin": "^\\s*((#)\\s*(?:ifndef|ifdef|if|elifndef|elifdef|elif|else|endif|error|warning|pragma|line))\\b",
          "end": "(?<!\\\\)$",
          "beginCaptures": {
            "1": { "name": "keyword.control.directive.falcon-asm" },
            "2": { "name": "punctuation.definition.directive.falcon-asm" }
          },
          "patterns": [ { "include": "#preprocessor-body" } ]
        }
      ]
    },
    "preprocessor-body": {
      "patterns": [
        { "include": "#block-comment" },
        {
          "name": "comment.line.double-slash.falcon-asm",
          "match": "(//).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.falcon-asm" } }
        },
        { "name": "constant.character.escape.line-continuation.falcon-asm", "match": "\\\\$" },
        { "include": "#string" },
        { "include": "#char" },
        { "include": "#operand" }
      ]
    },
    "string": {
      "name": "string.quoted.double.falcon-asm",
      "begin": "\"",
      "end": "\"|(?<!\\\\)$",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.falcon-asm" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.falcon-asm" } },
      "patterns": [ { "include": "#escape" } ]
    },
    "escape": {
      "name": "constant.character.escape.falcon-asm",
      "match": "\\\\(?:[0-7]{1,3}|[xX][0-9A-Fa-f]+|.)"
    },
    "char": {
      "comment": "GAS writes a character constant as 'c with no closing quote; cpp-era sources write 'c'. Accept both.",
      "name": "constant.character.falcon-asm",
      "match": "'(?:\\\\(?:[0-7]{1,3}|[xX][0-9A-Fa-f]+|.)|[^\\\\\\n])'?"
    },
    "label-definition": {
      "comment": "A label at statement start, plus the directive or mnemonic that may follow it on the same line. Folding the head in here is what lets '1:  addb ...' paint 'addb', since statement-head is anchored to line start.",
      "match": "^\\s*(?:([0-9]+)|([A-Za-z_.$][\\w.$]*))(:)(?:\\s*(?:(\\.[A-Za-z_][\\w.]*)|([A-Za-z_]\\w*)(?![\\w.$]|\\s*[:=])))?",
      "captures": {
        "1": { "name": "entity.name.label.falcon-asm" },
        "2": { "name": "entity.name.function.falcon-asm" },
        "3": { "name": "punctuation.separator.label.falcon-asm" },
        "4": { "name": "keyword.other.directive.falcon-asm" },
        "5": { "name": "keyword.other.mnemonic.falcon-asm" }
      }
    },
    "statement-head": {
      "comment": "First word of a statement: at line start or after the ';' separator. '.word' is a directive, a bare word is the mnemonic (or prefix; the server tells them apart). 'sym = expr' assignments are excluded.",
      "patterns": [
        {
          "match": "(?:^|(?<=;))\\s*(\\.[A-Za-z_][\\w.]*)",
          "captures": { "1": { "name": "keyword.other.directive.falcon-asm" } }
        },
        {
          "match": "(?:^|(?<=;))\\s*([A-Za-z_]\\w*)(?![\\w.$]|\\s*[:=])",
          "captures": { "1": { "name": "keyword.other.mnemonic.falcon-asm" } }
        }
      ]
    },
    "operand": {
      "patterns": [
        {
          "name": "variable.other.register.falcon-asm",
          "match": "(%)[A-Za-z][A-Za-z0-9]*",
          "captures": { "1": { "name": "punctuation.definition.variable.falcon-asm" } }
        },
        {
          "name": "constant.other.immediate.falcon-asm",
          "match": "\\$"
        },
        { "name": "constant.numeric.hex.falcon-asm", "match": "\\b0[xX][0-9A-Fa-f]+\\b" },
        { "name": "constant.numeric.binary.falcon-asm", "match": "\\b0[bB][01]+\\b" },
        {
          "comment": "Local label references: 1f is forward, 1b backward. Checked after binary so 0b101 stays a number while a bare 0b is a reference.",
          "name": "entity.name.label.reference.falcon-asm",
          "match": "\\b[0-9]+[bf]\\b"
        },
        { "name": "constant.numeric.octal.falcon-asm", "match": "\\b0[0-7]+\\b" },
        { "name": "constant.numeric.decimal.falcon-asm", "match": "\\b[0-9]+\\b" }
      ]
    }
  }
}
